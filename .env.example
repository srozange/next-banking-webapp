# Variables attendues par compose.yaml, sans valeur. `make secrets` génère .env (jamais versionné).
NB_IDENTITE_CLIENTS_BD_MOT_DE_PASSE=
NB_COEUR_BANCAIRE_BD_MOT_DE_PASSE=
NB_NOTIFICATIONS_BD_MOT_DE_PASSE=
NB_AUDIT_BD_MOT_DE_PASSE=
NB_CREDITS_BD_MOT_DE_PASSE=
NB_BOURSE_BD_MOT_DE_PASSE=
NB_OPEN_BANKING_CONSEILLER_BD_MOT_DE_PASSE=
# Paire RSA du jeton, DER en base64 sur une ligne, dérivée de .secrets/jeton-*.pem par `make secrets`.
NB_JETON_CLE_PRIVEE=
NB_JETON_CLE_PUBLIQUE=
# Fournisseur de cotations AlphaVantage (service bourse) : clé personnelle et adresse, vides par défaut.
# Sans clé, aucun appel réel n'est émis ; l'adaptateur simulé est actif par défaut.
ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_BASE_URL=

# Powens (service open-banking-conseiller) : vides par défaut. Domaine, client et banques sandbox sont dans le code ;
# le secret client n'a aucune valeur par défaut. L'adaptateur simulé est actif tant que le mode réel n'est pas demandé.
POWENS_CLIENT_SECRET=
POWENS_URL_RETOUR=
POWENS_DOMAINE=
POWENS_CLIENT_ID=
POWENS_CONNECTOR_ID=
