{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "credits.pret-demande.v1",
  "title": "Demande de prêt déposée (interne au service credits, lue par le scoring)",
  "description": "Publié par credits sur le topic credits.pret-demande.v1, clé pretId, chaîne JSON sans en-tête de type.",
  "type": "object",
  "required": ["idEvenement", "type", "version", "horodatage", "producteur", "donnees"],
  "additionalProperties": false,
  "properties": {
    "idEvenement": { "type": "string", "format": "uuid" },
    "type": { "const": "pret-demande" },
    "version": { "const": 1 },
    "horodatage": { "type": "string", "format": "date-time", "description": "ISO 8601 UTC, lu sur le port Horloge du producteur." },
    "producteur": { "const": "credits" },
    "donnees": {
      "type": "object",
      "required": ["pretId"],
      "additionalProperties": false,
      "properties": {
        "pretId": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "examples": [
    {
      "idEvenement": "3f2c1a9e-8b7d-4c6e-9f10-2a3b4c5d6e7f",
      "type": "pret-demande",
      "version": 1,
      "horodatage": "2026-10-06T08:30:00Z",
      "producteur": "credits",
      "donnees": { "pretId": 42 }
    }
  ]
}
