{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coeur-bancaire.temoin-ecrit.v1",
  "title": "Témoin écrit (flux témoin de l'epic 1)",
  "description": "Publié par coeur-bancaire sur le topic coeur-bancaire.temoin-ecrit.v1, clé temoinId, chaîne JSON sans en-tête de type.",
  "type": "object",
  "required": ["idEvenement", "type", "version", "horodatage", "producteur", "donnees"],
  "additionalProperties": false,
  "properties": {
    "idEvenement": { "type": "string", "format": "uuid" },
    "type": { "const": "temoin-ecrit" },
    "version": { "const": 1 },
    "horodatage": { "type": "string", "format": "date-time", "description": "ISO 8601 UTC, lu sur le port Horloge du producteur." },
    "producteur": { "const": "coeur-bancaire" },
    "donnees": {
      "type": "object",
      "required": ["temoinId"],
      "additionalProperties": false,
      "properties": {
        "temoinId": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "examples": [
    {
      "idEvenement": "3f2c1a9e-8b7d-4c6e-9f10-2a3b4c5d6e7f",
      "type": "temoin-ecrit",
      "version": 1,
      "horodatage": "2026-10-05T08:30:00Z",
      "producteur": "coeur-bancaire",
      "donnees": { "temoinId": 42 }
    }
  ]
}
